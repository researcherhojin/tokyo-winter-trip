{
  "name": "tokyo-travel-map-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "VITE_GOOGLE_MAPS_API_KEY= SINGLE_BUNDLE=1 npm run build -- --outDir output/test-build && node --test tests/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "start": "vite --host 127.0.0.1 --port 5173",
    "spellcheck": "cspell --config cspell.json --no-progress \"**/*\" \".*\"",
    "check": "node scripts/check.mjs",
    "qa:browser": "node scripts/browser-audit.mjs",
    "photos:archive": "node scripts/photo-archive.mjs",
    "stale": "node scripts/stale-checks.mjs"
  },
  "dependencies": {
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "cspell": "10.3.6",
    "jsdom": "26.1.0",
    "postcss": "8.5.24",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "@tailwindcss/postcss": "4.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
